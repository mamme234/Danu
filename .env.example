# Web (Vite) environment — names only; the actual values are set via Vercel secrets
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# Server-side (NEVER embed in the frontend bundle)
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="DANU <no-reply@danuorthopaedic.example>"
SMS_PROVIDER_API_URL=
SMS_PROVIDER_API_KEY=
ETB_PAYMENT_PROVIDER_URL=
ETB_PAYMENT_PROVIDER_KEY=
ETB_PAYMENT_WEBHOOK_SECRET=
SESSION_SECRET=

# Optional GitHub publishing (do NOT store the token in source code)
GITHUB_REPOSITORY=your-org/danu-orthopaedic-center
GITHUB_BRANCH=main
GITHUB_COMMITTER_NAME=DANU Releases
GITHUB_COMMITTER_EMAIL=releases@danuorthopaedic.example
# GITHUB_TOKEN must be supplied at runtime via your CI/CD or local env
